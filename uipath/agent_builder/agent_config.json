{
  "_comment": "UiPath Agent Builder configuration for Mopot. Defines the four Python agents as callable actions.",
  "agent": {
    "name": "Mopot Pipeline Agent",
    "description": "Autonomous mobile release pipeline — tests, fixes, and deploys Flutter apps.",
    "version": "1.0.0",
    "runtime": "python3.11",
    "working_directory": "${MOPOT_AGENT_DIR}"
  },
  "actions": [
    {
      "id": "run_tester",
      "name": "Test App",
      "description": "Navigate the running Flutter app via ADB, capture screenshots, and return a structured bug report.",
      "entry_point": "agents/tester_agent.py",
      "function": "run_tester",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": {"type": "string"},
          "project_path": {"type": "string"},
          "avd_name": {"type": "string", "default": "Pixel_9_Pro"},
          "apk_path": {"type": "string"},
          "max_screens": {"type": "integer", "default": 15}
        },
        "required": ["run_id", "project_path", "apk_path"]
      },
      "output_schema": {
        "type": "object",
        "description": "BugReport — see agents/tester_agent.py for full schema"
      }
    },
    {
      "id": "run_fixer",
      "name": "Fix Bugs",
      "description": "Use Claude to write code fixes for each reported bug, commit to a branch, and open a GitHub PR.",
      "entry_point": "agents/fixer_agent.py",
      "function": "run_fixer",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_context": {
            "type": "object",
            "properties": {
              "run_id": {"type": "string"},
              "project_path": {"type": "string"}
            }
          },
          "bug_report": {
            "type": "object",
            "description": "BugReport returned by run_tester"
          }
        },
        "required": ["run_context", "bug_report"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "branch_name": {"type": "string"},
          "pr_url": {"type": "string"},
          "pr_number": {"type": "integer"},
          "files_fixed": {"type": "array", "items": {"type": "string"}},
          "fixes_applied": {"type": "array"}
        }
      }
    },
    {
      "id": "run_asset_agent",
      "name": "Generate Release Assets",
      "description": "Use Claude to generate Play Store release notes and descriptions from git history.",
      "entry_point": "agents/asset_agent.py",
      "function": "run_asset_agent",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_context": {"type": "object"},
          "bug_report": {"type": "object"}
        },
        "required": ["run_context", "bug_report"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "release_notes": {"type": "string"},
          "short_description": {"type": "string"},
          "full_description": {"type": "string"},
          "whats_new": {"type": "string"},
          "screenshots": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "id": "run_deployer",
      "name": "Deploy to Play Store",
      "description": "Upload APK and metadata to Google Play Store internal testing track.",
      "entry_point": "agents/deployer_agent.py",
      "function": "run_deployer",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_context": {"type": "object"},
          "asset_package": {"type": "object"}
        },
        "required": ["run_context", "asset_package"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "track": {"type": "string"},
          "version_code": {"type": "integer"},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  ],
  "credentials_required": [
    "ANTHROPIC_API_KEY",
    "GITHUB_TOKEN",
    "PLAY_STORE_JSON_PATH",
    "PLAY_STORE_PACKAGE_NAME",
    "FLUTTER_PROJECT_PATH",
    "GITHUB_REPO"
  ],
  "_setup_instructions": [
    "1. In UiPath Agent Builder, create a new agent and import this config",
    "2. Set the working directory to the mopot project root",
    "3. Map each credentials_required item to the corresponding Orchestrator asset",
    "4. Test each action individually before connecting to the Maestro process"
  ]
}
